{{template "md-open" (print "CryoBackup daily digest, " .Date)}}{{template "md-top" (print "daily digest, " .Date " · polled " .Polled)}}{{template "md-strip" (bar .Level .Title)}}<tr><td class="cb-pad" bgcolor="{{tok "surface"}}" style="padding:4px 20px 8px 20px;background:{{tok "surface"}};">
{{template "md-label" "Fleet"}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
{{range $i, $t := .Tiles}}<td class="cb-tile" width="25%" valign="top" style="width:25%;padding:0 {{if lt $i 3}}4px{{else}}0{{end}} 0 {{if $i}}4px{{else}}0{{end}};">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{tok "surface-raised"}}" style="background:{{tok "surface-raised"}};border:1px solid {{tok "border"}};border-collapse:separate;border-radius:8px;"><tr><td style="padding:10px 12px;">
<div style="font-size:22px;line-height:26px;font-weight:700;color:{{tok $t.Colour}};">{{$t.N}}</div>
<div style="font-size:10.5px;line-height:14px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:{{tok "text-muted"}};">{{$t.Label}}</div>
</td></tr></table>
</td>
{{end}}</tr></table>
{{template "md-label" "Console"}}{{template "md-rows"}}{{if .Banners}}{{range $i, $b := .Banners}}<tr><td width="1%" valign="top" style="width:1%;padding:9px 0 9px 12px;white-space:nowrap;{{if $i}}border-top:1px solid {{tok "border"}};{{end}}">{{template "md-chip" (chip $b.Colour $b.Word)}}</td>
<td valign="top" style="padding:9px 12px;font-size:13px;line-height:18px;color:{{tok "text"}};{{if $i}}border-top:1px solid {{tok "border"}};{{end}}">{{$b.Text}}</td></tr>
{{end}}{{else}}<tr><td width="1%" valign="top" style="width:1%;padding:9px 0 9px 12px;white-space:nowrap;">{{template "md-chip" (chip "success" "OK")}}</td>
<td valign="top" style="padding:9px 12px;font-size:13px;line-height:18px;color:{{tok "text"}};">No console condition: every self-check passes.</td></tr>
{{end}}</table>
{{range .Sections}}{{template "md-label" .Title}}{{if .Groups}}{{$s := .}}{{range .Groups}}{{template "md-customer" .}}{{template "md-rows"}}{{range $i, $l := .Lines}}<tr><td width="1%" valign="top" style="width:1%;padding:9px 0 9px 12px;white-space:nowrap;{{if $i}}border-top:1px solid {{tok "border"}};{{end}}">{{template "md-chip" (chip $s.Colour $l.State)}}</td>
<td valign="top" style="padding:9px 12px;{{if $i}}border-top:1px solid {{tok "border"}};{{end}}"><div style="font-size:13px;line-height:18px;color:{{tok "text"}};">{{if $l.Host}}<span style="font-family:Consolas,'Courier New',monospace;font-weight:600;">{{$l.Host}}</span>{{else}}no active device{{end}}{{if $l.Ack}} <span style="font-size:10.5px;line-height:14px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:{{tok "text-muted"}};border:1px solid {{tok "border"}};border-radius:4px;padding:1px 5px;white-space:nowrap;">{{$l.Ack}}</span>{{end}}</div>
{{if or $l.Since $l.Also $l.Indefinite}}<div style="font-size:12px;line-height:18px;color:{{tok "text-muted"}};">{{if $l.Since}}since {{$l.Since}}{{end}}{{if $l.Indefinite}}; paused with no end date{{end}}{{if $l.Also}}; also {{$l.Also}}{{end}}</div>
{{end}}</td></tr>
{{end}}</table>
{{end}}{{else}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px dashed {{tok "border"}};border-collapse:separate;border-radius:8px;"><tr><td style="padding:9px 12px;font-size:12px;line-height:18px;color:{{tok "text-muted"}};">None. {{$.CheckedAs}} checked.</td></tr></table>
{{end}}{{end}}<div style="padding:16px 0 12px 0;font-size:14px;line-height:20px;color:{{tok "text"}};"><span style="font-weight:600;">Totals:</span> {{.Totals}}</div>
<div style="padding:0 0 16px 0;">{{template "md-cta" (cta .ConsoleURL true)}}</div>
</td></tr>
{{template "md-foot-open"}}This digest is sent every day, also when everything is green: a day without it means the console or its mail has stopped.<br>
You receive this because this address receives the CryoBackup daily digest.
</td></tr>
{{template "md-close"}}