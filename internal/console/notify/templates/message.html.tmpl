{{template "md-open" (print "CryoBackup: " .Title)}}{{template "md-top" (print "polled " .Polled)}}{{if .Recovery}}{{template "md-strip" (bar "success" .Title)}}{{else}}{{template "md-strip" (bar "danger" .Title)}}{{end}}{{template "md-body-open"}}{{if .Recovery}}{{template "md-label" "Recovery"}}{{else}}{{template "md-label" "Alert"}}{{end}}{{range .Groups}}{{template "md-customer" .}}{{template "md-rows"}}{{range $i, $l := .Lines}}<tr>{{template "md-chip-cell" $i}}{{if $.Recovery}}{{template "md-chip" (chip "success" "RESOLVED")}}{{else}}{{template "md-chip" (chip "danger" $l.State)}}{{end}}</td>
<td valign="top" style="padding:9px 12px;{{if $i}}border-top:1px solid {{tok "border"}};{{end}}">{{if $.Recovery}}<div style="font-size:13px;line-height:18px;color:{{tok "text"}};">{{if $l.Host}}<span style="font-family:Consolas,'Courier New',monospace;font-weight:600;">{{$l.Host}}</span> {{end}}<span style="font-weight:600;">{{$l.State}}</span></div>
<div style="font-size:12px;line-height:18px;color:{{tok "text-muted"}};">since {{$l.Since}}, ended {{$l.Ended}}{{if $l.Now}}; now {{$l.Now}}{{end}}</div>{{else}}<div style="font-size:13px;line-height:18px;color:{{tok "text"}};">{{if $l.Host}}<span style="font-family:Consolas,'Courier New',monospace;font-weight:600;">{{$l.Host}}</span>{{else}}no active device{{end}}</div>
<div style="font-size:12px;line-height:18px;color:{{tok "text-muted"}};">since {{$l.Since}}{{if $l.Class}}; error class {{$l.Class}}{{end}}</div>{{end}}</td></tr>
{{end}}{{template "md-rows-close"}}{{end}}{{template "md-sentence-open"}}{{if .Recovery}}These alarms have ended. No further mail is sent about them.{{else}}Each alarm is mailed once while it lasts. Acknowledge or snooze it in the console to mute it; a recovery notice follows when it ends.{{end}}</td></tr>
{{template "md-cta" (cta .ConsoleURL true)}}{{template "md-body-close"}}{{template "md-foot-open"}}{{if .Recovery}}You receive this because this address receives CryoBackup recovery notices.{{else}}You receive this because this address receives CryoBackup alerts.{{end}}
</td></tr>
{{template "md-close"}}