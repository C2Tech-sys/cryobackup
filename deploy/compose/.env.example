# CryoBackup compose stack: copy to .env and edit. .env is git-ignored; never commit it.
# Every variable the compose file references is listed here, with its default.
# Secrets (storage credentials) do NOT go here: they live in the rclone config files,
# except the lab-only MinIO credentials at the bottom, which protect a throw-away store.

# ---- storage target -----------------------------------------------------------
# Bucket and key prefix of the device repositories. The gateway serves
# store:<BUCKET>/<PREFIX>; each device lives at <PREFIX>/<device id>/ (architecture 3.2).
# BUCKET has no default: the compose file refuses to start without it.
BUCKET=cryobackup
# Leave empty for the bucket root. No leading or trailing slash.
PREFIX=fleet

# The storage provider, its endpoint and region are not variables: they are lines of the two
# rclone files (see rclone.conf.example), together with the credentials. The public names
# endpoints use (the agent API and the gateway) are config.json's public_url and gateway_url
# and the SAN of the certificates in TLS_DIR.

# ---- ports and binds ------------------------------------------------------------
# Agent API (public, TLS from TLS_DIR/agent.crt and agent.key via config.json).
AGENT_PORT=8443
# Admin UI and API. 127.0.0.1 keeps it loopback-only; rebind to a mesh or VPN address
# to reach it from your workstation. Never publish it to the internet.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080
# Gateway (public, TLS >= 1.2). The default is 9443 (architecture DH18). If the host
# already uses it, set another value; a lab host with 9443 taken uses 8000.
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=9443

# ---- files on the host ------------------------------------------------------------
# console config (schema owned by the console config package; start from config.example.json)
CONFIG_FILE=./config.json
# Directory holding master.key: 32 bytes, base64, mode 0400, readable by uid 10001. Created by
# `cryo-console init`. Mounted read-only at /run/keys (a directory, not a file, so Docker never
# creates a directory where the key should be). Back it up offline: losing it loses every
# escrowed repository password.
MASTER_KEY_DIR=./secrets
# Directory holding agent.crt, agent.key (console agent listener), gateway.crt, gateway.key
# (the gateway) and, optionally, admin.crt, admin.key (admin UI over TLS: set admin.tls in
# config.json, see README.md). See ../rclone/tls.md for the recipe and rotation.
TLS_DIR=./tls
# The two rclone config files. They are different files on purpose: the gateway gets the
# [store] remote only, maintenance gets the [admin] remote only (see rclone.conf.example).
RCLONE_GATEWAY_CONF=./rclone.gateway.conf
RCLONE_ADMIN_CONF=./rclone.admin.conf

# ---- images and pinned binaries -----------------------------------------------------
# Tag of the images this stack builds (console and maintenance share one image).
CRYO_VERSION=dev
CONSOLE_IMAGE=cryobackup/console
GATEWAY_IMAGE=cryobackup/gateway
# Base images. Pin by digest in production (name:tag@sha256:...).
GO_IMAGE=golang:1.26.10-bookworm
RUNTIME_IMAGE=debian:12.11-slim

# restic and rclone are downloaded at image build and verified against the SHA-256 of the
# release archive; a mismatch or an empty value fails the build (ADR 0003).
RESTIC_VERSION=0.19.1
# SHA-256 of restic_<RESTIC_VERSION>_linux_amd64.bz2, from
# https://github.com/restic/restic/releases/download/v0.19.1/SHA256SUMS
# (linux_arm64.bz2: a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465, and build with
# --build-arg RESTIC_ARCH=arm64)
RESTIC_SHA256=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c
RCLONE_VERSION=1.75.1
# SHA-256 of rclone-v<RCLONE_VERSION>-linux-amd64.zip, from
# https://downloads.rclone.org/v1.75.1/SHA256SUMS
# (linux-arm64.zip: 03f2504174034b6d004152ed7369251c9a9ec1f7e0836eda420f5c7a5ec0dff9, with RCLONE_ARCH=arm64)
RCLONE_SHA256=982b5aa772841168f8e380f139e9e787b2a105403e32b94da8676a0e1c0a13ab

# ---- lab profile only (docker compose --profile lab up) -------------------------------
# A throw-away MinIO. These credentials protect nothing of value: change them anyway.
# Keep them URL-safe (letters, digits, - _ .): minio-init passes the root pair to mc inside a URL.
#
# MinIO no longer publishes images or binaries: its community edition is source only and the
# upstream repository is archived. The lab therefore BUILDS the last pinned releases from the Go
# module proxy (minio.Dockerfile; GO_IMAGE above compiles them). Each value is an immutable
# pseudo-version, verified by sum.golang.org, of one release tag:
#   MINIO_MODULE_VERSION = RELEASE.2025-09-07T16-13-09Z
#   MC_MODULE_VERSION    = RELEASE.2025-08-13T08-35-41Z
# Lab fixture only, never a production target.
MINIO_LAB_IMAGE=cryobackup/minio-lab
MINIO_MODULE_VERSION=v0.0.0-20250907161309-07c3a429bfed
MC_MODULE_VERSION=v0.0.0-20250813083541-7394ce0dd2a8
# Bind and ports of the MinIO API and embedded console on the lab host.
MINIO_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=lab-root
MINIO_ROOT_PASSWORD=change-me-lab-root-password
# The two storage identities minio-init creates: the gateway user may put, get and list
# under the prefix and delete only lock files; the admin user may do everything in the bucket.
# Put the same values in rclone.conf (sections [store] and [admin]).
LAB_GATEWAY_ACCESS_KEY=lab-gateway
LAB_GATEWAY_SECRET_KEY=change-me-lab-gateway-secret
LAB_ADMIN_ACCESS_KEY=lab-admin
LAB_ADMIN_SECRET_KEY=change-me-lab-admin-secret
