# /etc/cryobackup/certsync.env (mode 0640 root:root; no secret, but nothing needs to read it except root).
# Copy this file, replace the placeholder host names, and keep the copy out of git.

# The host name each certificate was issued for: the one agents connect to
# (cryo-console's agent listener) and the one the gateway answers on. Leave one empty
# to skip that pair.
CERTSYNC_AGENT_HOST=console.example.invalid
CERTSYNC_GATEWAY_HOST=gateway.example.invalid

# Where the ACME client keeps its files; %s is replaced by the host name above.
# certbot (default):
CERTSYNC_CERT_PATTERN=/etc/letsencrypt/live/%s/fullchain.pem
CERTSYNC_KEY_PATTERN=/etc/letsencrypt/live/%s/privkey.pem
# acme.sh (ECC):  CERTSYNC_CERT_PATTERN=/root/.acme.sh/%s_ecc/fullchain.cer
#                 CERTSYNC_KEY_PATTERN=/root/.acme.sh/%s_ecc/%s.key
# lego:           CERTSYNC_CERT_PATTERN=/var/lib/lego/certificates/%s.crt
#                 CERTSYNC_KEY_PATTERN=/var/lib/lego/certificates/%s.key
# (every %s in a pattern becomes the host name)

# Optional overrides (defaults shown).
#CERTSYNC_DEST_DIR=/etc/cryobackup/tls
#CERTSYNC_OWNER=root:cryobackup
#CERTSYNC_MODE=0440
#CERTSYNC_AGENT_UNIT=cryo-console.service
#CERTSYNC_GATEWAY_UNIT=rclone-gateway.service
#CERTSYNC_WARN_DAYS=14
